{
	"name": "okica-3d",
	"version": "0.0.1",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@gltf-transform/core": "4.5.1",
		"@gltf-transform/extensions": "4.5.1",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@threlte/core": "^8.6.1",
		"@threlte/extras": "^9.22.3",
		"@types/node": "^26.6.5",
		"@types/pngjs": "6",
		"@types/three": "^0.186.0",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"node-html-parser": "^9.0.5",
		"pngjs": "7",
		"polygon-clipping": "0.15.7",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"three": "^0.186.1",
		"threlte-minify": "0.0.2",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"imports": {
		"#lib": "./src/lib",
		"#lib/*": "./src/lib/*"
	},
	"packageManager": "bun@1.4.2",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo \"\"",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "svelte-kit sync && prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:e2e": "playwright test"
	},
	"type": "module",
	"engines": {
		"bun": ">=1.4"
	}
}
